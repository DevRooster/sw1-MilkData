# Valores por defecto para Docker Compose.
#
# Compose lee este archivo automaticamente. NO es el `.env` que usa la API
# cuando corre en Windows: este solo configura los contenedores.
#
# Copiar a `.env.docker.local` y ahi cambiar lo que haga falta; ese archivo si
# esta en el `.gitignore`.

# Puerto donde la API responde en Windows.
API_PORT=3000

# Puerto donde MySQL responde en Windows. 3307 y no 3306 porque Laragon ya
# usa el 3306. Dentro del contenedor MySQL sigue en 3306.
DB_PORT_HOST=3307

# Base de datos
#
# Los nombres son `MYSQL_*` y no `DB_*` a proposito. Compose lee solo el `.env`
# de esta carpeta (el que usa la API en Windows), donde `DB_USER=root`; si el
# compose usara `${DB_USER}`, MySQL recibiria MYSQL_USER=root y se negaria a
# arrancar.
MYSQL_DATABASE=milkdata
MYSQL_USER=milkdata
MYSQL_PASSWORD=milkdata
MYSQL_ROOT_PASSWORD=milkdata_root

# JWT
# ESTO HAY QUE CAMBIAR antes de desplegar en serio: con la misma clave, cualquiera
# que la conozca puede firmar un token y pasar por admin.
JWT_SECRET=cambia-esto-en-produccion-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Limite de peticiones
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Empresa
EMPRESA_NOMBRE=Ecologica Huata
EMPRESA_UBICACION=
NOTIFICACION_PREFIJO=[MilkData]