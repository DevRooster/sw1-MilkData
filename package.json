{
  "name": "milkdata-backend",
  "version": "1.0.0",
  "description": "MilkData API backend for Planta Ecológica Huata",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --coverage --testPathPattern=tests/unit",
    "test:integration": "jest --coverage --testPathPattern=tests/integration"
  },
  "keywords": [
    "milkdata",
    "api",
    "express",
    "sequelize",
    "mysql"
  ],
  "author": "Planta Ecológica Huata",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "mysql2": "^3.24.3",
    "opossum": "^10.0.0",
    "p-retry": "^8.0.1",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
