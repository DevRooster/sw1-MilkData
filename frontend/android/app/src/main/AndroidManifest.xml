<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- La app habla con la API por HTTP. Sin este permiso, una compilación
         release no podría ni intentar la conexión: hasta ahora solo estaba en
         los manifest de debug y profile, que se fusionan únicamente en esas
         variantes. En release fallaría cualquier petición por falta de permiso,
         no por un problema de red, que es más difícil de diagnosticar. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Avisos del propio dispositivo sobre las notificaciones de la planta.

         Android 13 (API 33) y posteriores no avisan de nada si la app no declara
         este permiso, y además hay que pedirlo en tiempo de ejecucion. Sin las
         dos cosas, los canales se crean y no suena ninguno: el canal existe en
         los ajustes del movil y nunca llega nada por el, que es el peor fallo
         posible porque parece que todo funciona.

         `VIBRATE` es para que los avisos importantes viban; sin el, el canal de
         adulteracion aparece pero suena en silencio. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Imágenes: foto de perfil y fotos de referencia de productos.

         La cámara no lleva permiso: al declararla, Android exige pedirlo en
         tiempo de ejecución y, si se deniega, la app queda sin poder tomar
         fotos aunque la galería siga disponible. image_picker llama a la
         cámara por fuera de la app, así que el sistema pide el permiso a la
         aplicación de cámara, no a esta.

         Android 13 y posteriores ya no piden `READ_EXTERNAL_STORAGE` para
         leer imágenes: usa el selector del sistema, que es lo que hace
         image_picker. Sin ese permiso, elegir una foto desde la galería falla. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- La cámara es opcional: una app que solo necesita foto de perfil debería
         poder instalarse en una tablet sin cámara. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="milkdata_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
